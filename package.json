{
  "name": "openaether",
  "version": "0.1.0",
  "description": "An open-source AI CLI assistant — works with any LLM provider",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openaether": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "claude",
    "openai",
    "assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.3.0",
    "cli-spinners": "^3.2.0",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
